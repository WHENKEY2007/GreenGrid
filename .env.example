# ── Server Configuration ─────────────────────────────────────────────
PORT=5500
SPRING_PROFILES_ACTIVE=default

# ── MySQL Configuration (Only required when SPRING_PROFILES_ACTIVE=mysql) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=squadup
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ── Security & Authentication ────────────────────────────────────────
SQUADUP_TOKEN_TTL=24h
SQUADUP_SEED_ENABLED=true

# ── Chat Moderation ──────────────────────────────────────────────────
SQUADUP_CHAT_MAX_LENGTH=2000
SQUADUP_CHAT_BANNED_WORDS=idiot,stupid,loser
