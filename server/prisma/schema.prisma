generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ConsumptionSource {
  MANUAL
  SMART_METER
  ESTIMATED
}

enum RenewableSource {
  SOLAR
  WIND
  OTHER
}

enum AlertType {
  HIGH_CONSUMPTION
  HIGH_COST
  DEVICE_OVERUSE
  LOW_RENEWABLE_RATIO
  GENERAL
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices               Device[]
  consumptions          EnergyConsumption[]
  renewableGenerations  RenewableGeneration[]
  alerts                Alert[]
  settings              EnergySettings?

  @@index([email])
  @@index([role])
}

model Device {
  id               String   @id @default(cuid())
  userId           String
  name             String
  category         String
  ratedPower       Float    // In Watts
  quantity         Int      @default(1)
  usageHoursPerDay Float
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumptions EnergyConsumption[]

  @@index([userId])
  @@index([category])
}

model EnergyConsumption {
  id        String            @id @default(cuid())
  userId    String
  deviceId  String?
  date      DateTime
  energyKwh Float
  cost      Float
  source    ConsumptionSource @default(MANUAL)
  createdAt DateTime          @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([deviceId])
}

model RenewableGeneration {
  id            String          @id @default(cuid())
  userId        String
  source        RenewableSource @default(SOLAR)
  generationKwh Float
  date          DateTime
  capacityKw    Float
  createdAt     DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model EnergyTariff {
  id            String    @id @default(cuid())
  name          String
  ratePerKwh    Float
  fixedCharge   Float     @default(0.0)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([isActive])
}

model Alert {
  id        String    @id @default(cuid())
  userId    String
  type      AlertType @default(GENERAL)
  title     String
  message   String
  threshold Float?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model EnergySettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  dailyConsumptionLimit   Float    @default(20.0) // kWh
  monthlyConsumptionLimit Float    @default(500.0) // kWh
  monthlyCostLimit        Float    @default(5000.0) // Currency units
  carbonFactor            Float    @default(0.82) // kg CO2 per kWh
  alertEnabled            Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
